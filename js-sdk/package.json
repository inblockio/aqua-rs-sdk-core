{
  "name": "aqua-core-js",
  "version": "0.1.0",
  "description": "TypeScript wrapper for aqua-rs-sdk-core compiled to WebAssembly: create, sign, export, verify, and selectively disclose Aqua trees in Node and browsers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/inblockio/aqua-rs-sdk-core",
    "directory": "js-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "example": "node examples/node-example.mjs"
  },
  "keywords": [
    "aqua",
    "aqua-protocol",
    "audit",
    "provenance",
    "wasm"
  ],
  "dependencies": {
    "aqua-rs-sdk-core-wasm": "file:../wasm/pkg"
  },
  "devDependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
